# 서버
PORT=8080

# 데이터베이스 (docker compose 사용 시 DB_HOST=mysql 로 자동 설정됨)
DB_HOST=localhost
DB_PORT=3306
DB_USER=gdg
DB_PASSWORD=gdgpassword
DB_NAME=gdgdb

# 인증 - 반드시 길고 무작위인 값으로 바꾸세요 (예: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# CORS 허용 Origin (쉼표 구분, * 은 전체 허용)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# IP당 초당 요청 수 / 버스트
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# DB 쿼리 타임아웃 / 종료 대기 시간
DB_QUERY_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
